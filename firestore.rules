rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // プランナーのアプリ用（同じ Firebase プロジェクト「planner」で使っている分。消さないこと）
    match /planners/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 講義タスク帳用：各ユーザーは users/<自分のuid> の1件だけを読み書きできる
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'at'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 500000;
    }
    // ここに書いていない場所は、すべて読み書きできない（Firestore の初期動作）
  }
}
